# PocketBase, pinned by version and verified by checksum.
#
# There is no official PocketBase image. Building from the published release
# with a recorded checksum pins the binary as tightly as a digest would and
# avoids trusting a third-party image for the component that holds identity.
FROM alpine:3.20

ARG PB_VERSION=0.39.11
ARG PB_SHA256=08b9fcda0d5fd42cb315dc15a36dfa121c993855bd635f01d347c31b4328ec34

RUN apk add --no-cache unzip ca-certificates wget \
 && wget -q -O /tmp/pb.zip \
      "https://github.com/pocketbase/pocketbase/releases/download/v${PB_VERSION}/pocketbase_${PB_VERSION}_linux_amd64.zip" \
 && echo "${PB_SHA256}  /tmp/pb.zip" | sha256sum -c - \
 && unzip /tmp/pb.zip -d /pb \
 && rm /tmp/pb.zip \
 && apk del unzip wget

COPY pocketbase-entrypoint.sh /usr/local/bin/pocketbase-entrypoint.sh
RUN chmod +x /usr/local/bin/pocketbase-entrypoint.sh

EXPOSE 8090
ENTRYPOINT ["/usr/local/bin/pocketbase-entrypoint.sh"]
CMD ["/pb/pocketbase", "serve", "--http=0.0.0.0:8090", "--dir=/pb/pb_data", "--migrationsDir=/pb/pb_migrations"]
