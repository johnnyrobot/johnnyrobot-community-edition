# ============================================================================
# Local Development Environment Configuration
# ============================================================================
# Copy this file to .env before bringing up the local stack:
#
#   cp .env.local.example .env
#   docker compose -f docker-compose.prod.yml -f docker-compose.local.yml up -d --build
#
# Every service reads a file literally named .env; there is no separate local
# environment file to wire up.
# ============================================================================

# ===========================
# Persistence & Auth
# ===========================
# Same internal Compose address as production: PocketBase runs on the Compose
# network only and publishes no host port, locally or deployed.
POCKETBASE_URL=http://pocketbase:8090
# Still required -- the pocketbase service fails `docker compose up` without
# them. Any values work on a laptop; these never leave your machine.
POCKETBASE_SUPERUSER_EMAIL=operator@example.com
POCKETBASE_SUPERUSER_PASSWORD=local-development-password

# Canvas token encryption. Leave blank unless you are testing
# Canvas: without a key the Canvas endpoints return a clean 503 and the rest
# of the application works normally. To test Canvas, generate a key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CANVAS_TOKEN_KEY=
CANVAS_TOKEN_KEY_VERSION=1

# ===========================
# LiveKit Configuration
# ===========================
# Real LiveKit Cloud credentials -- this stack does not run a local LiveKit
# server. No inbound port is needed: the agent dials out.
# Get these from: https://cloud.livekit.io/projects/<your-project>/settings/keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxx
LIVEKIT_API_SECRET=secretxxxxxxxxxx

# ===========================
# Google Gemini Configuration
# ===========================
# Required for RAG (File Search) and for the Gemini Realtime voice provider.
# Get an API key from: https://ai.google.dev/
GOOGLE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================
# OpenAI Configuration (Optional)
# ===========================
# Only needed if you set AI_PROVIDER=openai below.
OPENAI_API_KEY=

# ===========================
# AI Provider Selection
# ===========================
# Options: "google" (Gemini Realtime) or "openai" (GPT-4o Realtime)
AI_PROVIDER=google

# ===========================
# Language Configuration
# ===========================
# Supported: en-US, es-ES, es-MX, vi-VN, fr-FR, de-DE, ja-JP, ko-KR, zh-CN
AGENT_LANGUAGE=en-US

# ===========================
# Mem0 Configuration
# ===========================
# Optional, and genuinely blank here on purpose: with no key configured
# Student Memory is a logged no-op -- chat and voice still work, they simply
# do not remember across sessions. Fill it in from https://app.mem0.ai/ only
# if you are exercising memory locally.
MEM0_API_KEY=

# Or keep Student Memory on your own machine instead, which needs no Mem0
# account at all. Set this to true and the stack runs mem0's OSS memory over
# the local Qdrant and Neo4j below, using your Gemini key as its LLM and
# embedder. Self-hosted wins over MEM0_API_KEY if both are set.
MEM0_SELF_HOSTED=true

# The graph and vector store behind self-hosted Student Memory. Both are
# private to the Compose network. NEO4J_PASSWORD is required whenever the
# neo4j service runs -- `docker compose up` fails rather than starting a graph
# on the image's default credential.
#
# Leaving NEO4J_URL blank keeps memory working from the vector store alone: you
# lose relationships between memories, not memory.
NEO4J_URL=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=a-local-neo4j-password

# The Course Material graph. Both have working defaults; set them only to
# change the extraction model or to widen the connect bound on a slow host.
# GRAPH_BUILD_TIMEOUT_SECONDS=10
# GRAPH_EXTRACTION_MODEL=gemini-2.5-flash

QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ===========================
# Application Configuration
# ===========================
# Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=change-this-to-a-random-secret-key

# The local override also pins these two on the backend and agent services,
# because docker-compose.prod.yml sets them explicitly for the deployed stack.
ENVIRONMENT=development
DEBUG=true

# Login throttling, keyed on the address Caddy forwards. Same defaults as
# production; lower them if you want to exercise the throttle by hand.
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# This project declares ResetOnly recovery locally too. The reset
# script refuses to run against any other profile.
DEPLOYMENT_PROFILE=ResetOnly

# ===========================
# Deployment Configuration
# ===========================
APP_DOMAIN=localhost
FRONTEND_URL=http://localhost
# Blank on purpose: the frontend and the API share one origin behind Caddy
# locally exactly as they do in production, so no cross-origin request is ever
# made. An explicitly empty value means no origins.
CORS_ORIGINS=
