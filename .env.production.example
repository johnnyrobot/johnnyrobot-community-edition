# ============================================================================
# Production Environment Configuration for VPS Deployment
# ============================================================================
# Copy these values to your .env file on the server
# DO NOT commit actual secrets to git
# ============================================================================

# ===========================
# Persistence & Auth
# ===========================
# PocketBase holds identity and persistence. It is private to the Compose
# network; no host port is published and no certificate is issued for it.
# The superuser credential is required at container start, not at first request.
POCKETBASE_URL=http://pocketbase:8090
POCKETBASE_SUPERUSER_EMAIL=operator@your-domain.example
POCKETBASE_SUPERUSER_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD

# Custodied outside PocketBase: possession of pb_data alone must not decrypt
# any Student's Canvas token. Bump the version when you rotate the key.
CANVAS_TOKEN_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
CANVAS_TOKEN_KEY_VERSION=1

# ===========================
# LiveKit Configuration
# ===========================
# Get these from: https://cloud.livekit.io/projects/<your-project>/settings/keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxx
LIVEKIT_API_SECRET=secretxxxxxxxxxx

# ===========================
# Google Gemini Configuration
# ===========================
# Required for RAG (File Search) and Embeddings
GOOGLE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================
# OpenAI Configuration
# ===========================
# Required for Voice Agent (Realtime API)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================
# AI Provider Selection
# ===========================
# Choose which AI provider to use for the voice agent
# Options: "google" (Gemini Realtime) or "openai" (GPT-4o Realtime)
AI_PROVIDER=google

# ===========================
# Language Configuration
# ===========================
# Set the agent's primary language
# Supported: en-US, es-ES, es-MX, vi-VN, fr-FR, de-DE, ja-JP, ko-KR, zh-CN
AGENT_LANGUAGE=en-US

# ===========================
# Mem0 Configuration
# ===========================
# Get API key from: https://app.mem0.ai/
# Optional: left empty (as shipped) Student Memory is a no-op -- chat and voice
# still work, they simply do not remember across sessions. A key that is wrong,
# expired, or unreachable degrades the same way rather than failing a request.
MEM0_API_KEY=

# ===========================
# Application Configuration
# ===========================
# IMPORTANT: Generate a strong random secret key for production
# Run this command to generate one:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET_KEY

# Environment (should be 'production')
ENVIRONMENT=production

# Debug mode (should be 'false' in production)
DEBUG=false

# Login throttling, keyed on the address Caddy forwards
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# This deployment declares ResetOnly recovery. Earlier state is never
# restored, and the reset script refuses to run against any other profile.
DEPLOYMENT_PROFILE=ResetOnly

# ===========================
# Deployment Configuration
# ===========================
# Public hostname served by Caddy, without a scheme or path.
APP_DOMAIN=your-domain.example
FRONTEND_URL=https://your-domain.example
CORS_ORIGINS=

# ===========================
# Security Reminders
# ===========================
# 1. Never commit actual secrets to git
# 2. Keep all .env files in .gitignore
# 3. Use strong, unique passwords for each service
# 4. Rotate secrets regularly (every 90 days recommended)
# 5. Enable 2FA on all external service accounts
# 6. Keep the PocketBase superuser credential out of logs, images, and the frontend build
