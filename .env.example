# ============================================================================
# Johnny Robot Community Edition Environment Configuration Template
# Copy this file to .env and fill in your actual values
# ============================================================================

# ===========================
# Persistence & Auth
# ===========================
# PocketBase is the persistence provider. It runs on the Compose
# network only and is never published to the host; the browser never learns
# this address.
POCKETBASE_URL=http://pocketbase:8090
# Provisioned on first container start. A missing value fails `docker compose
# up` rather than the first login.
POCKETBASE_SUPERUSER_EMAIL=operator@example.com
POCKETBASE_SUPERUSER_PASSWORD=change-this-to-a-long-random-password

# Canvas token encryption. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CANVAS_TOKEN_KEY=
CANVAS_TOKEN_KEY_VERSION=1

# The Canvas instance this deployment syncs from, e.g.
# https://canvas.your-institution.edu
#
# Required to connect a Canvas source; there is no default, because a
# committed hostname would point every installation of this self-hosted
# software at one institution's Canvas. Left unset, Canvas is
# simply unavailable -- connecting a source answers 503 -- and the rest of
# the application runs normally.
#
# Changing it later affects only *new* connections. A Canvas API token
# authenticates against one instance and no other, so each Student's record
# stores the instance its token belongs to and keeps using it; repointing
# this value cannot redirect an existing credential at a host it would fail
# against. Students on the old instance must reconnect. Their imported
# Course Materials survive that disconnect.
CANVAS_BASE_URL=

# ===========================
# LiveKit Configuration
# ===========================
# Get these from: https://cloud.livekit.io/projects/<your-project>/settings/keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxx
LIVEKIT_API_SECRET=secretxxxxxxxxxx

# ===========================
# Google Gemini Configuration
# ===========================
# Get API key from: https://ai.google.dev/
# Required for Voice Agent (Gemini Realtime) and RAG (File Search)
GOOGLE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================
# OpenAI Configuration (Optional)
# ===========================
# Get API key from: https://platform.openai.com/api-keys
# Only required if using OpenAI as the voice provider (AI_PROVIDER=openai)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================
# AI Provider Selection
# ===========================
# Choose which AI provider to use for the voice agent
# Options: "google" (Gemini Realtime - recommended) or "openai" (GPT-4o Realtime)
# Note: Google Gemini is used for RAG regardless of this setting
AI_PROVIDER=google

# ===========================
# Language Configuration
# ===========================
# Set the agent's default language (user preferences override this)
# Supported: en-US, es-ES, es-MX, vi-VN, fr-FR, de-DE, ja-JP, ko-KR, zh-CN
AGENT_LANGUAGE=en-US

# ===========================
# Mem0 Configuration
# ===========================
# Get API key from: https://app.mem0.ai/
# Used for persistent conversation memory across sessions
# Optional: left empty (as shipped) Student Memory is a no-op -- chat and voice
# still work, they simply do not remember across sessions. A key that is wrong,
# expired, or unreachable degrades the same way rather than failing a request.
MEM0_API_KEY=

# How long to wait for Mem0 while the client is built, once, at startup. mem0
# sets no timeout of its own, so against a host that drops packets the wait
# would be whatever the OS decides. Set 0 to wait as long as it takes.
MEM0_TIMEOUT_SECONDS=10

# Keep Student Memory on this deployment's own infrastructure rather than
# Mem0's. Runs mem0's OSS memory over the Qdrant and Neo4j below, with Gemini
# as its LLM and embedder -- Gemini rather than OpenAI on purpose, so the
# mem0ai/livekit-agents version conflict recorded in requirements.txt stays
# dormant. Takes precedence over MEM0_API_KEY when both are set.
#
# A half-configured self-hosted deployment is a logged no-op, never a silent
# fallback to somewhere the Operator did not choose.
MEM0_SELF_HOSTED=false

# The graph. NEO4J_PASSWORD is required whenever the neo4j service runs.
# Leaving NEO4J_URL blank keeps memory working from the vector store alone --
# a graph-disabled deployment stays valid.
NEO4J_URL=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# The Course Material graph. Both have working defaults; set them only to
# change the extraction model or to widen the connect bound on a slow host.
# GRAPH_BUILD_TIMEOUT_SECONDS=10
# GRAPH_EXTRACTION_MODEL=gemini-2.5-flash

# The vector store. Without it there is nowhere to keep what is remembered, so
# a self-hosted deployment with no QDRANT_HOST is a no-op.
QDRANT_HOST=
QDRANT_PORT=6333

# ===========================
# Application Configuration
# ===========================
# Generate a random secret key for production:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Environment: development | staging | production
ENVIRONMENT=development

# Enable debug mode (set to false in production)
DEBUG=true

# Login throttling, keyed on the address Caddy forwards
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# This deployment declares ResetOnly recovery. Earlier state is never
# restored, and the reset script refuses to run against any other profile.
DEPLOYMENT_PROFILE=ResetOnly

# ===========================
# CORS Configuration
# ===========================
# Public hostname served by Caddy. Use your real hostname in production.
APP_DOMAIN=localhost
# Allowed CORS origins (comma-separated)
# Add your domain or Cloudflare Tunnel URL if testing on remote devices
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
